# ---------------------------------------------------------------------------
# Microsoft SQL Server profile (target production database)
#
# Requires on the server:
#   1. Microsoft ODBC Driver 18 for SQL Server
#   2. PHP extensions sqlsrv + pdo_sqlsrv matching the PHP build
#      (PHP 8.2, x64, ZTS  ->  php_sqlsrv_82_ts_x64.dll / php_pdo_sqlsrv_82_ts_x64.dll)
#      placed in the extension_dir and enabled in php.ini:
#        extension=php_sqlsrv_82_ts_x64.dll
#        extension=php_pdo_sqlsrv_82_ts_x64.dll
#
# Copy the values below over the DB_* block of .env, then run:
#   php artisan migrate:fresh --seed
# ---------------------------------------------------------------------------

DB_CONNECTION=sqlsrv
DB_HOST=YOUR_SQLSERVER_HOST
DB_PORT=1433
DB_DATABASE=PharmaVerify
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# TrustServerCertificate is required when the instance uses a self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=yes
