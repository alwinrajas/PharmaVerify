# ---------------------------------------------------------------------------
# Microsoft SQL Server profile (target production database)
#
# Requires on the server:
#   1. Microsoft ODBC Driver 18 for SQL Server
#   2. PHP extensions sqlsrv + pdo_sqlsrv matching the PHP build
#      (PHP 8.2, x64, ZTS  ->  php_sqlsrv_82_ts_x64.dll / php_pdo_sqlsrv_82_ts_x64.dll)
#      placed in the extension_dir and enabled in php.ini:
#        extension=php_sqlsrv_82_ts_x64.dll
#        extension=php_pdo_sqlsrv_82_ts_x64.dll
#
# Copy the values below over the DB_* block of .env, then run:
#   php artisan migrate:fresh --seed
# ---------------------------------------------------------------------------

DB_CONNECTION=sqlsrv
DB_HOST=YOUR_SQLSERVER_HOST
DB_PORT=1433
DB_DATABASE=PharmaVerify
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# TrustServerCertificate is required when the instance uses a self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=yes

# ---------------------------------------------------------------------------
# OneDrive / Microsoft Graph
# ---------------------------------------------------------------------------
# Leave the driver as "demo" until the Azure app registration exists; the demo
# driver writes to local storage and needs no credentials.
#
# Switch to "graph" only when all of TENANT_ID, CLIENT_ID, CLIENT_SECRET and
# one of DRIVE_ID / USER_PRINCIPAL hold real values. A YOUR_ placeholder left
# in any of them is treated as unconfigured and the share is refused before
# anything is sent to Microsoft.
#
# See docs/09-ONEDRIVE-INTEGRATION.md for the app registration steps.

ONEDRIVE_DRIVER=demo
ONEDRIVE_TENANT_ID=YOUR_TENANT_ID
ONEDRIVE_CLIENT_ID=YOUR_CLIENT_ID
ONEDRIVE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# One of the two identifies the destination. DRIVE_ID wins if both are set.
ONEDRIVE_DRIVE_ID=
ONEDRIVE_USER_PRINCIPAL=

ONEDRIVE_FOLDER="PharmaVerify/FinalOutput"
